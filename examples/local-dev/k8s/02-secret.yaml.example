# Copy to 02-secret.yaml, fill in real values, and DO NOT commit it.
# Better: create it imperatively instead of committing any file —
#   kubectl create secret generic ai4ia-secrets -n ai4ia \
#     --from-literal=API_KEY=... \
#     --from-literal=SUPABASE_URL=... \
#     --from-literal=SUPABASE_SERVICE_KEY=... \
#     --from-literal=AI4IA_OBJECT_STORAGE_ACCESS_KEY=<your-s3-access-key> \
#     --from-literal=AI4IA_OBJECT_STORAGE_SECRET_KEY=<your-s3-secret-key> \
#     --from-literal=REDIS_PASSWORD=<only if Redis requires auth>

apiVersion: v1
kind: Secret
metadata:
  name: ai4ia-secrets
  namespace: ai4ia
type: Opaque
stringData:
  API_KEY: "<random-api-key>"
  SUPABASE_URL: "https://<project-ref>.supabase.co"
  SUPABASE_SERVICE_KEY: "<supabase-service-role-key>"
  # Only needed if Redis requires auth — see backend/app/core/settings.py
  # _apply_redis_password. Leave unset for an unauthenticated Redis (the
  # in-cluster StatefulSet in 03-redis.yaml has none by default).
  REDIS_PASSWORD: ""
