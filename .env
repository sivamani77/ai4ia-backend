API_KEY=
ALLOWED_ORIGINS=["https://ai4ia.io", "http://localhost:8080", "https://ai4ia-backend.nexusconnects.ai", "https://ai4ia-backend.gov-cloud.ai", "https://ai4iah.gov-cloud.ai"]

# Chroma
CHROMA_MODE=http
CHROMA_HOST=chromadb.chromadb.svc.cluster.local
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION=fragments
ACCESS_TOKEN_TTL_SECONDS=2592000

# Redis — standalone in redis-single (service: redis-service)
REDIS_URL=redis://redis-service.redis-single.svc.cluster.local:6379/0

NAME=dev1

# Object storage — AWS S3 (verified reachable). Empty endpoint = real AWS.
AI4IA_STORAGE_BACKEND=s3
AI4IA_OBJECT_STORAGE_BUCKET=ai4ia-data
AI4IA_OBJECT_STORAGE_REGION=ap-south-2
AI4IA_OBJECT_STORAGE_ENDPOINT=
AWS_DEFAULT_REGION=ap-south-2

# LLM endpoints (external mobius — keep for first cut)
OLLAMA_BASE_URL=http://ollama-mobius-sales.mobiusdtaas.ai

# App behaviour
ALLOWED_ORIGINS=["https://ai4ia-backend.gov-cloud.ai","https://ai4iah.gov-cloud.ai","https://ai4ia.io","http://localhost:8080","https://ai4ia-backend.nexusconnects.ai"]
TRANSLATION_ENABLED=true
AI4IA_ENABLE_HLS_STREAMING=1
REFRESH_COOKIE_SECURE=true

# Celery worker
WORKER_CONCURRENCY=6
WORKER_QUEUE=video_jobs
WORKER_LOGLEVEL=info

# Mail (password is in the Secret)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=ai4ia@mobiusdtaas.ai
MAIL_FROM_ADDRESS=ai4ia@mobiusdtaas.ai
MAIL_FROM_NAME=AI4IA (No Reply)

# OpenTelemetry traces (see backend/app/core/otel.py). Leave unset to
# disable tracing entirely (safe default — api/worker skip all
# instrumentation when this is empty). Point it at the in-cluster OTel
# Collector once DevOps stands one up, e.g.
# "http://otel-collector.ai4ia.svc.cluster.local:4317"
OTEL_EXPORTER_OTLP_ENDPOINT=