# Local rehearsal settings for the speaker cleanup (docs/runbooks/speaker-cleanup-plan.md).
# Load only through scripts/localtest_run.sh. Every value here overrides .env,
# which points at cluster hosts and must never be used for a rehearsal.
# Contains no secrets.

DATABASE_URL=postgresql://ai4ia:ai4ia_local_dev@localhost:15432/ai4ia

CHROMA_MODE=http
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_COLLECTION=fragments
CHROMA_AUTH_TOKEN=

# No Redis for the rehearsal; an unreachable port keeps it from touching anything.
REDIS_URL=redis://localhost:1/0

AI4IA_STORAGE_BACKEND=local
AI4IA_OBJECT_STORAGE_ACCESS_KEY=
AI4IA_OBJECT_STORAGE_SECRET_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AUTH_SUPABASE_URL=
AUTH_SUPABASE_SERVICE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
MAIL_SMTP_HOST=
