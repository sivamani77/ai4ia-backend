[Unit]
Description=AI4IA Knowledge Intelligence Backend (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ai4ia-demo-pipeline/backend
Environment=OLLAMA_BASE_URL=http://ollama-mobius-sales.mobiusdtaas.ai
# 4 workers so a slow 70B LLM request doesn't block other endpoints.
ExecStart=%h/ai4ia-demo-pipeline/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8077 --workers 4
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
