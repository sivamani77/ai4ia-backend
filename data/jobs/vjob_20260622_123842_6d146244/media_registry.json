    "visual_S2_CONTEXT": {
      "object_id": "visual_S2_CONTEXT",
      "kind": "visual_asset",
      "local_path": "/home/ash/ai4ia-demo-pipeline/data/generated_assets/storyline_20260622_181025_validated/visuals/S2_CONTEXT_visual.png",
      "filename": "S2_CONTEXT_visual.png",
      "content_type": "image/png",
      "size_bytes": 227732,
      "created_at": "2026-06-22T12:47:24.829590",
      "section_id": "S2_CONTEXT",
      "visual_title": "Understanding the Issue",
      "visual_asset_type": "diagram",
      "visual_keywords": [
