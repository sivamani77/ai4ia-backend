    "voiceover_S6_SYNTHESIS": {
      "object_id": "voiceover_S6_SYNTHESIS",
      "kind": "voiceover_audio",
      "local_path": "/home/ash/ai4ia-demo-pipeline/data/generated_assets/storyline_20260623_152606_validated/audio/sections/S6_SYNTHESIS_narration_broll_voiceover.mp3",
      "filename": "S6_SYNTHESIS_narration_broll_voiceover.mp3",
      "content_type": "audio/mpeg",
      "size_bytes": 102960,
      "created_at": "2026-06-23T09:59:51.948364",
      "section_id": "S6_SYNTHESIS",
      "voiceover_text": "As we've seen, AI is playing an increasingly important role in helping us mitigate the effects of climate change and disasters. From improving detection and prediction to developing new technologies for adaptation and mitigation, AI has the potential to make a significant impact."
