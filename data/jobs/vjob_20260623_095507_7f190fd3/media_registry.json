      "object_id": "visual_S5_RESPONSE",
      "kind": "visual_asset",
      "local_path": "/home/ash/ai4ia-demo-pipeline/data/generated_assets/storyline_20260623_152606_validated/visuals/S5_RESPONSE_visual.png",
      "filename": "S5_RESPONSE_visual.png",
      "content_type": "image/png",
      "size_bytes": 210534,
      "created_at": "2026-06-23T10:00:11.824681",
