      "content_type": "image/png",
      "size_bytes": 222840,
      "created_at": "2026-06-23T09:59:56.150432",
      "section_id": "S1_HOOK",
      "visual_title": "The Central Question",
      "visual_asset_type": "concept_card",
      "visual_keywords": [
